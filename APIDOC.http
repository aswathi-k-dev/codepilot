#============== ASSESMENT API ====================

# api call for list assesmnts
###
GET http://127.0.0.1:8000/exams/assessments/ 
Accept: application/json
Authorization: Token 3245012543f75886ed57b74137fb6e386032f21e

# api call for creating assesmnts
###
POST http://127.0.0.1:8000/exams/assessments/create/
Content-Type: application/json
Authorization: Token 3245012543f75886ed57b74137fb6e386032f21e

{
    "title": "Django phase 2 Assessment",
    "batch": "Python Batch 2",
    "language": "PYTHON",
    "exam_date": "2026-11-2",
    "duration": 2,
    "start_time": "08:00",
    "status": "UPCOMING"
}

#api call for fetching
###
GET http://127.0.0.1:8000/exams/assessments/1/ 
Accept: application/json
Authorization: Token 3245012543f75886ed57b74137fb6e386032f21e

#api call for updating
###
PUT http://127.0.0.1:8000/exams/assessments/1/ 
